# managed by 86server: do not edit
[Unit]
Description=86server Cloudflare Tunnel (cloudflared)
After=network-online.target
Wants=network-online.target
# Runs only once the manager has set up a tunnel (Cloudflare page or `86server cloudflare`).
ConditionPathExists=/opt/86server/data/manager/cloudflared.env

[Service]
# TUNNEL_TOKEN, written by the manager.
EnvironmentFile=/opt/86server/data/manager/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
