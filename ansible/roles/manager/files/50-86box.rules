polkit.addRule(function(action, subject) {
    if (subject.user != "86boxmgr") return polkit.Result.NOT_HANDLED;
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (/^(vm|vnc|vm-settings)@[a-z][a-z0-9-]{1,30}\.service$/.test(unit) &&
            ["start", "stop", "restart"].indexOf(verb) >= 0) return polkit.Result.YES;
        if (unit == "caddy.service" && verb == "reload") return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
