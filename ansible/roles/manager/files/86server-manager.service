[Unit]
Description=86server web manager
After=network.target

[Service]
User=86server
Group=86server
UMask=0007
WorkingDirectory=/opt/86server/manager
ExecStart=/usr/bin/python3 /opt/86server/manager/server.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/86server/data /opt/86server/media /opt/86server/etc/caddy/sites.d /opt/86server/etc/caddy/panel.d
MemoryMax=150M

[Install]
WantedBy=multi-user.target
