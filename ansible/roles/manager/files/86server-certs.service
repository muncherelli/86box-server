# managed by 86server: do not edit
[Unit]
Description=86server: renew the Cloudflare zone certificates that are due
After=network-online.target
Wants=network-online.target
# Nothing to renew until Cloudflare is set up (86server cloudflare or the Cloudflare page).
ConditionPathExists=/opt/86server/data/manager/edge.json

[Service]
Type=oneshot
User=86server
Group=86server
UMask=0027
WorkingDirectory=/opt/86server/manager
ExecStart=/usr/bin/python3 /opt/86server/manager/cli.py renew-certs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/86server/data
