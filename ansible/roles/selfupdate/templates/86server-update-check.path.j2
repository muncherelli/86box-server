[Unit]
Description=Check for undeployed commits when the clone's HEAD moves or a deploy finishes

[Path]
# git appends to logs/HEAD on every commit, checkout, merge, reset and pull.
PathChanged={{ b86_repo }}/.git/logs/HEAD
PathChanged=/opt/86server/etc/deployed.json
Unit=86server-update-check.service
TriggerLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
