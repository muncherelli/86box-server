{% set lan = lan_hosts | default([]) %}
{% set tun = tunnel_hosts | default([]) %}
{
	admin unix//run/caddy/admin.sock
{% if edge_mode == 'acme' %}
	email {{ acme_email }}
{% endif %}
{% if edge_mode == 'internal' or lan | length > 0 %}
	# Caddy runs unprivileged and cannot add its local CA to the system store; trust it on clients instead.
	skip_install_trust
{% endif %}
{% if edge_mode == 'tunnel' or tun | length > 0 %}
	# cloudflared connects from localhost: take the visitor's address from Cloudflare's header.
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers Cf-Connecting-Ip
	}
{% endif %}
}

(b86_edge) {
{% if edge_mode == 'internal' %}
	tls internal
{% endif %}
}

# The manager, its consoles and the console websocket. Argument: the scheme the visitor uses.
(b86_manager) {
	handle /manage/* {
		reverse_proxy 127.0.0.1:8686 {
			header_up X-B86-Client-IP {client_ip}
			header_up X-B86-Proto {args[0]}
		}
	}
	handle /auth/* {
		respond 404
	}
	handle /novnc/* {
		uri strip_prefix /novnc
		root * /opt/86server/vendor/novnc/current
		file_server
	}
	handle /websockify {
		forward_auth 127.0.0.1:8686 {
			uri /auth/check
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
		reverse_proxy 127.0.0.1:6080
	}
	handle {
		redir * /manage/ 302
	}
}
{% if manager_host | default('') %}

{{ ('http://' ~ manager_host) if edge_mode == 'tunnel' else manager_host }} {
	import b86_edge
	import b86_manager {{ 'https' if edge_mode == 'tunnel' else '{http.request.scheme}' }}
}
{% endif %}
{% for h in lan %}

# LAN: plain http (no redirect) and https with Caddy's own local CA.
http://{{ h }}, https://{{ h }} {
	tls internal
	import b86_manager {http.request.scheme}
}
{% endfor %}
{% for h in tun %}

# Cloudflare Tunnel: cloudflared sends plain http to localhost:80; the visitor is on https at Cloudflare.
http://{{ h }} {
	import b86_manager https
}
{% endfor %}

import /etc/caddy/sites.d/*.caddy
