{% set lan = lan_hosts | default([]) %}
{
	admin unix//run/caddy/admin.sock
	# Caddy runs unprivileged and cannot add its local CA to the system store; trust it on clients instead.
	skip_install_trust
	# cloudflared connects from localhost: take the visitor's address from Cloudflare's header. Visitors on the
	# LAN connect directly, so their own address is used and the header is ignored.
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers Cf-Connecting-Ip
	}
}

# The manager, its consoles and the console websocket. Argument: the scheme the visitor uses.
(b86_manager) {
	handle /manage/* {
		reverse_proxy 127.0.0.1:8686 {
			header_up X-B86-Client-IP {client_ip}
			header_up X-B86-Proto {args[0]}
		}
	}
	handle /auth/* {
		respond 404
	}
	handle /novnc/* {
		uri strip_prefix /novnc
		root * /opt/86server/vendor/novnc/current
		file_server
	}
	handle /websockify {
		forward_auth 127.0.0.1:8686 {
			uri /auth/check
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
		reverse_proxy 127.0.0.1:6080
	}
	handle {
		redir * /manage/ 302
	}
}
{% for h in lan %}

# LAN: plain http (no redirect) and https with Caddy's own local CA.
http://{{ h }}, https://{{ h }} {
	tls internal
	import b86_manager {http.request.scheme}
}
{% endfor %}

# Default site: any other name or address that reaches this server (for example its IP) gets the manager too.
# Names above, the panel name and published sites match first. https gets a certificate from Caddy's local CA
# on first use; a visit by IP has no SNI, so the certificate is made for the address the browser connected to.
http://, https:// {
	tls internal {
		on_demand
	}
	import b86_manager {http.request.scheme}
}

# Written by the manager (Cloudflare page or `86server cloudflare`): the control panel's name (panel.d) and
# published sites (sites.d). Names in a Cloudflare zone use that zone's Let's Encrypt wildcard certificate.
import /opt/86server/etc/caddy/panel.d/*.caddy
import /opt/86server/etc/caddy/sites.d/*.caddy
