[Unit]
Description=86server firewall table
After=ufw.service 86server-bridges.service
ConditionPathExists=/opt/86server/etc/86server.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /opt/86server/etc/86server.nft
ExecReload=/usr/bin/nft -f /opt/86server/etc/86server.nft
ExecStop=-/usr/bin/nft delete table inet b86server

[Install]
WantedBy=multi-user.target
