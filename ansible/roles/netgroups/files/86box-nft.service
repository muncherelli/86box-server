[Unit]
Description=86server firewall table
After=ufw.service 86box-bridges.service
ConditionPathExists=/opt/86server/etc/b86box.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /opt/86server/etc/b86box.nft
ExecReload=/usr/bin/nft -f /opt/86server/etc/b86box.nft
ExecStop=-/usr/bin/nft delete table inet b86box

[Install]
WantedBy=multi-user.target
