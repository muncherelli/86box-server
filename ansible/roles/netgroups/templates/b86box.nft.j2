# managed by 86box-server: do not edit
# The first two lines make loading atomic: the table is replaced in one step.
table inet b86box
delete table inet b86box
table inet b86box {
  set ourbr {
    type ifname
{% if netgroups %}
    elements = { {% for name, g in netgroups.items() %}"{{ g.bridge }}"{{ ", " if not loop.last }}{% endfor %} }
{% endif %}
  }
{% if edge_mode == 'cf-origin' and cf4_ranges | default([]) %}
  set cf4 {
    type ipv4_addr
    flags interval
    elements = { {{ cf4_ranges | join(', ') }} }
  }
  set cf6 {
    type ipv6_addr
    flags interval
    elements = { {{ cf6_ranges | join(', ') }} }
  }
{% endif %}
  chain input {
    type filter hook input priority filter - 5; policy accept;
{% if edge_mode == 'cf-origin' and cf4_ranges | default([]) %}
    iifname "lo" accept
    tcp dport { 80, 443 } ip saddr != @cf4 drop
    tcp dport { 80, 443 } ip6 saddr != @cf6 drop
{% endif %}
    iifname @ourbr ct state established,related accept
{% for name, g in netgroups.items() if g.dhcp | default(false) %}
    iifname "{{ g.bridge }}" udp dport 67 accept
{% endfor %}
    iifname @ourbr drop
  }
  chain forward {
    type filter hook forward priority filter - 5; policy accept;
    ct state established,related accept
{% for pair in group_routes | default([]) %}
    iifname "{{ netgroups[pair[0]].bridge }}" oifname "{{ netgroups[pair[1]].bridge }}" accept
    iifname "{{ netgroups[pair[1]].bridge }}" oifname "{{ netgroups[pair[0]].bridge }}" accept
{% endfor %}
{% for name, g in netgroups.items() if g.egress | default('none') == 'nat' %}
{% if g.egress_allow | default([]) %}
    iifname "{{ g.bridge }}" oifname != @ourbr ip daddr { {{ g.egress_allow | join(', ') }} } accept
{% else %}
    iifname "{{ g.bridge }}" oifname != @ourbr accept
{% endif %}
{% endfor %}
    iifname @ourbr drop
    oifname @ourbr drop
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
{% for name, g in netgroups.items() if g.egress | default('none') == 'nat' %}
    ip saddr {{ g.cidr }} oifname != @ourbr masquerade
{% endfor %}
  }
}
