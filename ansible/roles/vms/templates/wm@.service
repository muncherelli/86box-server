[Unit]
Description=Window manager for box %i (makes the 86Box window fill the display)
BindsTo=vnc@%i.service
After=vnc@%i.service

[Service]
User={{ b86_user }}
Group={{ b86_user }}
EnvironmentFile={{ vm_data_root }}/boxdefs/%i.env
RuntimeDirectory=wm-%i
Environment=HOME=%t/wm-%i
ExecStartPre=/opt/86server/libexec/wait-x %i
ExecStart=/usr/bin/openbox --config-file /opt/86server/openbox-rc.xml
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=-/tmp/.X11-unix
