[Unit]
Description=86Box %i
Requires=vnc@%i.service
Wants=wm@%i.service
After=vnc@%i.service wm@%i.service 86box-bridges.service

[Service]
User={{ b86_user }}
Group={{ b86_user }}
UMask=0007
EnvironmentFile={{ vm_data_root }}/boxdefs/%i.env
Environment=QT_QPA_PLATFORM=xcb HOME={{ vm_data_root }}/boxes/%i
# Keep Qt's font cache out of the box folder: the manager could not delete or copy what 86Box wrote there.
Environment=XDG_CACHE_HOME=/opt/86server/cache/box
ReadWritePaths=/opt/86server/cache/box
ExecStartPre=/bin/sh -c '! systemctl is-active --quiet box-settings@%i.service'
ExecStartPre=+/opt/86server/libexec/cfg-guard %i
ExecStartPre=/opt/86server/libexec/ensure-resize %i
ExecStartPre=/opt/86server/libexec/wait-x %i
ExecStart=/opt/86server/vendor/86box/current/AppRun -N -P {{ vm_data_root }}/boxes/%i/ -R /opt/86server/vendor/roms/current -L {{ vm_data_root }}/boxes/%i/86box.log
ExecStartPost=+/opt/86server/libexec/tap-check %i
ExecStopPost=+/opt/86server/libexec/stop-display %i box
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ vm_data_root }}/boxes/%i -/tmp/.X11-unix
ReadOnlyPaths={{ media_root }}
InaccessiblePaths=-{{ vm_data_root }}/manager -{{ vm_data_root }}/certs -{{ vm_data_root }}/vnc-tokens
KillSignal=SIGHUP
TimeoutStopSec=10
Restart=no
