[Unit]
Description=86Box VM %i
Requires=vnc@%i.service
Wants=wm@%i.service
After=vnc@%i.service wm@%i.service 86box-bridges.service

[Service]
User={{ vm_service_user }}
Group={{ vm_service_user }}
SupplementaryGroups={{ vm_share_group }}
UMask=0007
EnvironmentFile={{ vm_data_root }}/vmdefs/%i.env
Environment=QT_QPA_PLATFORM=xcb HOME={{ vm_data_root }}/vms/%i
# Keep Qt's font cache out of the VM folder: the manager could not delete or copy what 86Box wrote there.
CacheDirectory=86box-vm
Environment=XDG_CACHE_HOME=/var/cache/86box-vm
ExecStartPre=/bin/sh -c '! systemctl is-active --quiet vm-settings@%i.service'
ExecStartPre=+/opt/86box-server/libexec/cfg-guard %i
ExecStartPre=/opt/86box-server/libexec/ensure-resize %i
ExecStartPre=/opt/86box-server/libexec/wait-x %i
ExecStart=/opt/86box-server/86box/current/AppRun -N -P {{ vm_data_root }}/vms/%i/ -R /opt/86box-server/roms/current -L {{ vm_data_root }}/vms/%i/86box.log
ExecStartPost=+/opt/86box-server/libexec/tap-check %i
ExecStopPost=+/opt/86box-server/libexec/stop-display %i vm
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ vm_data_root }}/vms/%i -/tmp/.X11-unix
ReadOnlyPaths={{ vm_data_root }}/media
InaccessiblePaths={{ vm_data_root }}/manager
KillSignal=SIGHUP
TimeoutStopSec=10
Restart=no
