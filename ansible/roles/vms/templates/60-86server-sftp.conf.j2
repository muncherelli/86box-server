# managed by 86server: do not edit
Match Group 86server-sftp
    ChrootDirectory /opt/86server/sftp
    ForceCommand internal-sftp -u 0002 -d /media
    AuthorizedKeysFile /opt/86server/etc/ssh/sftp-keys/%u
    PasswordAuthentication no
    AllowTcpForwarding no
    X11Forwarding no
    PermitTunnel no
Match all
