#!/bin/sh
# ExecStopPost of box@ and box-settings@: stop the VNC display when 86Box ended on its own.
# When someone ran stop or restart, systemd already handles vnc@ (it is PartOf the box), and
# stopping it again here would cancel the restart's own start job and leave everything down.
# $1 is the box name; $2 is the unit prefix (box or box-settings).
if systemctl list-jobs --no-legend | grep -q "^ *[0-9]* $2@$1\.service"; then
  exit 0
fi
exec systemctl stop --no-block "vnc@$1.service"
