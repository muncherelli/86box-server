# managed by 86box-server: do not edit
legacy.example.com {
	import b86_edge
	request_body {
		max_size 1MB
	}
	@b86enc expression `{http.request.orig_uri}.matches("(?i)^[^?]*(%25|%2e|%2f|%5c|%c0|%c1|%u|\\.\\.|::|\\\\)")`
	@b86method not method GET HEAD POST
	@b86p_iis4 path_regexp (?i)^/(scripts|iisadmin|iisadmpwd|iishelp|iissamples|msadc|printers|_vti_[a-z_]*|_private)(/|$)|\.(htr|ida|idq|printer|htw|idc|htx|stm|shtm|shtml|asa|cdx|cer)$
	@b86deny not path_regexp ^(/)
	route {
		respond @b86enc 400
		respond @b86method 405
		respond @b86p_iis4 404
		respond @b86deny 404
		reverse_proxy 10.86.1.10:80
	}
}
